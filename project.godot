; Engine configuration file.
; 眼動鼠之寶島卡車（資料夾：眼動鼠之歐卡 2）

config_version=5

[application]

config/name="眼動鼠之寶島卡車"
config/description="眼動鼠 3D 駕駛：台灣景點與市區模擬駕駛、駕駛室儀錶板、平板導航、交通標誌識別、左駕訓練、小柯機器人 AI 自駕"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.11, 0.2, 1)
boot_splash/show_image=false
config/quit_on_go_back=false
config/windows_native_icon="res://platform/icon.ico"
run/low_processor_mode=false

[audio]

general/text_to_speech=true
general/ios/session_category=3
general/ios/mix_with_others=false

[autoload]

App="*res://scripts/app.gd"
Gaze="*res://scripts/gaze.gd"
Snd="*res://scripts/snd.gd"
Updater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/ui_font.tres"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.macos="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
environment/defaults/default_clear_color=Color(0.5, 0.6, 0.7, 1)
